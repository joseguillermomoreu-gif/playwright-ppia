{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "baseUrl": ".",
    "paths": {
      "@agents/*": ["src/agents/*"],
      "@ai/*": ["src/ai/*"],
      "@browser/*": ["src/browser/*"],
      "@config/*": ["src/config/*"],
      "@executor/*": ["src/executor/*"],
      "@suite/*": ["src/suite/*"],
      "@domain/*": ["src/domain/*"],
      "@cli/*": ["src/cli/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
